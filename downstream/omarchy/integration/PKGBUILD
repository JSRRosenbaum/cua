# Omarchy session integration for the matched downstream Cua Driver.
# Installing this package stages files only. User-session activation, client
# registration, and the native input flag all require separate explicit verbs.
pkgname=cua-omarchy-integration
pkgver=0.29.1
pkgrel=2
pkgdesc='Session-bound Cua Driver controls and Omarchy input flag'
arch=('any')
url='https://github.com/trycua/cua'
license=('MIT')
depends=('cua-driver-omarchy' 'python' 'systemd')
optdepends=('cua-hyprland-plugin-local: ABI-checked native input'
            'python-yaml: safe Hermes MCP registration')
source=('bin/cua-omarchy' 'systemd/cua-driver-omarchy.service'
        'hypr/cua-input.lua' 'omarchy/menu-items.json' '../../../LICENSE.md')
sha256sums=('1f10f74ea3def985ce7a8a7b05223806faca738c6c15053f9ba187d08b08b5fc'
            'ca5a82d4c4a9dd385e1055fbf1919f58b277f61691045f077665daecf92b4aa0'
            '052fcfe2cb765ab6f2e01d027df237f6774917fdd81a8723bb011804e2e22e6e'
            'a4bbdfb221b55312a655686ee5eb40f2e612cf812d71f6f3afa108d95a0942bd'
            'c0779290c1d4783169aa3dbfb55feb505e563ef8a004bbf55298ceffcfbda8d9')

package() {
  install -Dm755 "$srcdir/cua-omarchy" "$pkgdir/usr/bin/cua-omarchy"
  install -Dm644 "$srcdir/cua-driver-omarchy.service" \
    "$pkgdir/usr/lib/systemd/user/cua-driver-omarchy.service"
  install -Dm644 "$srcdir/cua-input.lua" \
    "$pkgdir/usr/share/cua-omarchy/hypr/cua-input.lua"
  install -Dm644 "$srcdir/menu-items.json" \
    "$pkgdir/usr/share/cua-omarchy/menu-items.json"
  install -Dm644 "$srcdir/LICENSE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
