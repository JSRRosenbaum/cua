  "trigger.cua.revoke-all": {"icon": "󰑓", "label": "Revoke All Service Sessions", "action": "omarchy-launch-floating-terminal-with-presentation 'cua-omarchy revoke-all-prompt'"},
  "trigger.cua.disable-input": {"icon": "󰒲", "label": "Disable Native Input", "action": "omarchy-launch-floating-terminal-with-presentation 'cua-omarchy disable-input'"}
}
