# Local Omarchy fork candidate. Render this recipe from a reviewed immutable
# source/profile kit; never install while the currently mapped plugin is active.
# shellcheck shell=bash disable=SC2034,SC2154
pkgname=cua-hyprland-plugin-local
pkgver=@DRIVER_VERSION@
pkgrel=1
pkgdesc='Input-enabled Cua module for the exact staged Hyprland fork ABI'
arch=('x86_64')
url='https://github.com/trycua/cua'
license=('MIT')
depends=('hyprland-cua=@COMPOSITOR_PACKAGE_VERSION@' @ABI_DEPENDS@ '@PLUGIN_LIBEI_DEPEND@' 'binutils' 'python')
makedepends=('cmake' 'ninja' 'pkgconf')
conflicts=('cua-hyprland-plugin')
options=('!strip' '!debug' '!lto')
source=('cua-source.tar.gz' 'SOURCE-PROVENANCE.json' 'PROFILE.json'
        'KIT-PROVENANCE.json' 'profile_verify.py' 'hyprland.pc')
sha256sums=('@SOURCE_SHA256@' '@SOURCE_MANIFEST_SHA256@' '@PROFILE_SHA256@'
            '@KIT_SHA256@' '@VERIFIER_SHA256@' '@PKGCONFIG_SHA256@')

_verify() {
  env -u LD_PRELOAD -u FAKEROOTKEY -u FAKED_MODE \
    python3 "$startdir/profile_verify.py" verify-build --kit "$startdir" \
      --extracted "$srcdir/cua-source" --require-installed-candidate || return 1
  local staged="$startdir"
  local reported
  reported="$(PKG_CONFIG_PATH="$staged${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
      pkgconf --modversion hyprland)" || return 1
  [[ "$reported" == 0.56.2 ]] || {
    printf 'error: candidate header version changed (%s)\n' "$reported" >&2
    return 1
  }
}

prepare() {
  _verify
}

build() {
  _verify || return 1
  [[ ! -e "$srcdir/build" ]] || {
    printf 'error: retained CMake build directory is not a fresh reviewed build\n' >&2
    return 1
  }
  PKG_CONFIG_PATH="$startdir${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
    cmake -S "$srcdir/cua-source/libs/cua-driver/hyprland-plugin" \
      -B "$srcdir/build" -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CXX_COMPILER=/usr/bin/g++ -DPKG_CONFIG_EXECUTABLE=/usr/bin/pkgconf \
      -DPKG_CONFIG_USE_CMAKE_PREFIX_PATH=OFF \
      -DCUA_HYPRLAND_EXPECTED_VERSION=0.56.2 \
      -DCUA_HYPRLAND_INPUT=ON -DCUA_HYPRLAND_TEST_INPUT=OFF \
      -DCUA_HYPRLAND_INPUT_TRACE=OFF -DCUA_HYPRLAND_TEST_OPERATOR_KEY= \
      -DBUILD_TESTING=ON || return 1
  cmake --build "$srcdir/build" --parallel 2
}

check() {
  _verify || return 1
  ctest --test-dir "$srcdir/build" --output-on-failure --no-tests=error || return 1
  sha256sum "$srcdir/build/cua-hyprland-plugin.so" > "$srcdir/checked-module.sha256"
}

package() {
  _verify || return 1
  [[ -f "$srcdir/checked-module.sha256" ]] || {
    printf 'error: native module has not passed its configured tests\n' >&2
    return 1
  }
  sha256sum --check "$srcdir/checked-module.sha256" || return 1
  env -u LD_PRELOAD -u FAKEROOTKEY -u FAKED_MODE \
    python3 "$startdir/profile_verify.py" record-build --kit "$startdir" \
      --module "$srcdir/build/cua-hyprland-plugin.so" \
      --extracted "$srcdir/cua-source" --build "$srcdir/build" \
      --output "$srcdir/BUILD-PROVENANCE.json" || return 1
  install -Dm755 "$srcdir/build/cua-hyprland-plugin.so" \
    "$pkgdir/usr/lib/cua/hyprland/cua-hyprland-plugin.so" || return 1
  install -Dm644 "$srcdir/cua-source/LICENSE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || return 1
  local name
  for name in SOURCE-PROVENANCE.json PROFILE.json KIT-PROVENANCE.json profile_verify.py; do
    install -Dm644 "$startdir/$name" "$pkgdir/usr/share/cua-hyprland-plugin/$name" || return 1
  done
  install -Dm644 "$srcdir/BUILD-PROVENANCE.json" \
    "$pkgdir/usr/share/cua-hyprland-plugin/BUILD-PROVENANCE.json"
}
